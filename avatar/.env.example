# Keep this file free of credentials. Copy to .env for local overrides.
# The demo works without either backend.
# Native Gemini Live: direct continuous audio, provider VAD and native speech.
# Store the key in an ignored gemini.env or .env; never a VITE_ variable.
GEMINI_API_KEY=
# GOOGLE_API_KEY is an accepted server-only alias.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE_MOSS=Charon
GEMINI_LIVE_VOICE_ORBIT=Kore
GEMINI_LIVE_VOICE_SPARK=Puck

# Native OpenAI Realtime is selected when only its key is configured.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Native OpenRouter: complete WAV input -> streamed GPT Audio/Coral output.
# Explicitly opt in with AVATAR_VOICE_PROVIDER=openrouter-native.
# HTTP utterance transport, with continuous local listening and local barge-in.
# See docs/OPENROUTER_NATIVE.md for current qualification and PCM-rate assumption.
# You can put the key in an ignored openrouter.env instead of .env.
OPENROUTER_API_KEY=
# Recognition observes native speech in parallel for text/intent; it never generates the voice.
OPENROUTER_STT_MODEL=openai/whisper-large-v3
# The older chained STT/chat/TTS adapter remains an explicit optional provider.
# It is enabled only with AVATAR_VOICE_PROVIDER=openrouter.
OPENROUTER_CHAT_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-lite-tts
OPENROUTER_TTS_VOICE_MOSS=Charon
OPENROUTER_TTS_VOICE_ORBIT=Kore
OPENROUTER_TTS_VOICE_SPARK=Puck
# Default: Gemini key -> OpenAI key -> no native voice. OpenRouter is never automatic.
# AVATAR_VOICE_PROVIDER=gemini-live
# AVATAR_VOICE_PROVIDER=openrouter-native
# AVATAR_VOICE_PROVIDER=openrouter
# AVATAR_VOICE_PROVIDER=openai-realtime

# Bounded self-hosted native conversation audition, explicitly selected only.
# A private operator launcher must already have warmed one GPU Sandbox.
# Browser requests never start GPUs. Lease includes a temporary private token;
# keep it ignored, ACL-restricted, and outside the static frontend.
# AVATAR_VOICE_PROVIDER=personaplex
# AVATAR_PERSONAPLEX_LEASE_FILE=C:/absolute/path/to/avatar/.local/personaplex-browser/lease.json

# Optional utterance recognition beside native PersonaPlex audio. Disabled by default.
# Requires the existing OpenRouter key and a ready native session owned by this browser.
# Enables /transcribe only; PersonaPlex never uses OpenRouter /conversation or /speech.
# AVATAR_BACKGROUND_ASR=openrouter

# Optional visible read-only inquiry bridge. Disabled by default.
# Requires Savia + native OpenRouter, or PersonaPlex with opted-in background ASR.
# Native OpenRouter uses server-held receipts for native result narration; PersonaPlex uses captions.
# Banking auth still belongs to Savia. No new dispute/card/payment actions are available.
# AVATAR_NATIVE_READ_BRIDGE=readonly

# Opt into the installed authenticated Savia frontend, never the FLUJO worker.
# SAVIA_UPSTREAM=http://127.0.0.1:43800
# Installed local Savia uses this exact Origin, independent of upstream address.
# SAVIA_PUBLIC_ORIGIN=http://localhost:43800

AVATAR_HOST=127.0.0.1
AVATAR_PORT=4318
# Optional exact origins, comma-separated. Development already allows :4317.
# AVATAR_ALLOWED_ORIGINS=http://localhost:4317,http://127.0.0.1:4317

# Remote deployment: put an authenticated HTTPS ingress in front of the server.
# Strip inbound X-Avatar-Gateway-Token; the ingress sets it after its own auth.
# The gate is separate from the user's Savia account login.
# AVATAR_HOST=0.0.0.0
# AVATAR_ALLOW_PUBLIC_BIND=true
# AVATAR_PUBLIC_ORIGIN=https://avatar.example.com
# AVATAR_ACCESS_GATE_TOKEN=<operator-generated-random-base64url-secret>

# Installed Savia can wait 450 seconds for a worker turn. Timeouts never prove cancellation.
AVATAR_TASK_TIMEOUT_MS=460000

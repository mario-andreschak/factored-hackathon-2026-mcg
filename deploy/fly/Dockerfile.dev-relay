# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
WORKDIR /app
COPY --chown=root:root --chmod=0644 dev-relay.mjs /app/dev-relay.mjs
RUN node --check /app/dev-relay.mjs
USER node
EXPOSE 8080
CMD ["node", "/app/dev-relay.mjs"]

FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS ui
WORKDIR /src
COPY frontend/package*.json frontend/
RUN cd frontend && npm ci --no-audit --no-fund
COPY frontend frontend
RUN cd frontend && npm run build
COPY avatar/package*.json avatar/
RUN cd avatar && npm ci --no-audit --no-fund
COPY avatar avatar
RUN cd avatar && npm run build && npm prune --omit=dev --no-audit --no-fund

FROM python:3.13-slim-bookworm@sha256:5024f48ba9441d4b13a95d3945abc6365538e3a31109833367a1923523c6efed
RUN apt-get update && apt-get install -y --no-install-recommends tini libstdc++6 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=ui /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY . .
RUN pip install --no-cache-dir -r requirements-dispute.txt
COPY --from=ui /src/frontend/dist frontend/dist
COPY --from=ui /src/avatar/dist avatar/dist
COPY --from=ui /src/avatar/node_modules avatar/node_modules
RUN python -c "import hashlib,json,pathlib; r=pathlib.Path('.'); m=json.loads((r/'source-manifest.json').read_text()); assert all(hashlib.sha256((r/p).read_bytes()).hexdigest()==h for p,h in m['files'].items())"
ENV PYTHONUNBUFFERED=1
EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--", "python", "deploy/rc/public_start.py"]

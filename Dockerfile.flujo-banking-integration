# Rebuild the EXISTING FLUJO worker from an explicitly selected application build.
# The application image is a FLUJO Dockerfile builder stage, compiled with the
# trusted hackathon adapter. This file creates an image, not another service.
ARG FLUJO_APPLICATION_IMAGE=flujo-banking-builder:local
ARG FLUJO_WORKER_IMAGE=flujo-slack-worker:banking-stdio-base
FROM ${FLUJO_APPLICATION_IMAGE} AS application
FROM ${FLUJO_WORKER_IMAGE}
USER root
COPY --from=application /app/.next /app/.next
COPY --from=application /app/next.config.mjs /app/next.config.mjs
COPY --from=application /app/package.json /app/package-lock.json /app/
COPY --from=application /app/scripts /app/scripts
COPY --from=application /app/node_modules/jose /app/node_modules/jose
COPY --from=application /app/node_modules/canonicalize /app/node_modules/canonicalize

# A dedicated, tested binary is used only by the optional restricted profile.
# The normal Codex executable and existing model configurations stay in the base.
RUN npm install --prefix /opt/codex-restricted --omit=dev --no-audit --no-fund @openai/codex@0.153.3
WORKDIR /opt/banking-mcp
COPY requirements-mcp.txt requirements-pipeline.txt requirements-s3.txt ./
RUN test -x .venv/bin/python || python3 -m venv .venv
RUN .venv/bin/pip install --no-cache-dir -r requirements-mcp.txt
COPY banking_mcp ./banking_mcp
COPY pipeline ./pipeline
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ARG FLUJO_BUILD_REVISION
RUN node -e 'if (!/^[a-f0-9]{40}$/.test(process.argv[1])) process.exit(1)' "${FLUJO_BUILD_REVISION}"
ENV FLUJO_BUILD_REVISION=${FLUJO_BUILD_REVISION}
LABEL org.opencontainers.image.revision="${FLUJO_BUILD_REVISION}"
WORKDIR /app
USER node
# Inherit the established worker command, healthcheck, toolchains and volumes.

  "uncontracted_seven_families": {
    "branches": {
      "documented_relationships": [
        "customers.registration_branch_id -> branches.branch_id",
        "products.opening_branch_id -> branches.branch_id",
        "service_agents.assigned_branch_id -> branches.branch_id",
        "transactions.branch_id -> branches.branch_id",
        "complaints.related_branch_id -> branches.branch_id"
      ],
      "purpose": "Historical branch dimension for location reporting or branch directory enrichment.",
      "banking_frontend_need": "Optional branch-label enrichment if requested; current owner-scoped transaction/status workflow does not display branch lookup.",
      "next_contracts": "Unique branch_id; required fields; valid locations/status vocabulary. Audit optional branch FKs in existing six families before enrichment."
    },
    "service_agents": {
      "documented_relationships": [
        "service_agents.assigned_branch_id -> branches.branch_id",
        "call_center_interactions.agent_id -> service_agents.agent_id",
        "call_transcripts.agent_id -> service_agents.agent_id",
        "satisfaction_surveys.agent_id -> service_agents.agent_id",
        "complaints.assigned_agent_id -> service_agents.agent_id"
      ],
      "purpose": "Historical staff characteristics and operational analytics.",
      "banking_frontend_need": "Not needed for transaction ownership or app authentication. Historical generated staff IDs are not verified login identities.",
      "next_contracts": "Unique agent_id; branch FK; optional agent FKs; strip names/contact details from analytics outputs. Dictionary monthly_snapshot is physically one unpartitioned CSV."
    },
    "marketing_campaigns": {
      "documented_relationships": [
        "campaign_sends.campaign_id -> marketing_campaigns.campaign_id"
      ],
      "purpose": "Campaign dimension for marketing analytics.",
      "banking_frontend_need": "Not needed for charge inquiry/status verification.",
      "next_contracts": "Unique campaign_id; start_date/end_date consistency; categorical vocabulary. promoted_product is VARCHAR descriptor, not a documented product_id FK."
    },
    "campaign_sends": {
      "documented_relationships": [
        "campaign_sends.campaign_id -> marketing_campaigns.campaign_id",
        "campaign_sends.customer_id -> customers.customer_id"
      ],
      "purpose": "Delivery, engagement and conversion events.",
      "banking_frontend_need": "Not needed for charge inquiry/status verification; no transaction_id join or authorization basis.",
      "next_contracts": "Unique send_id; customer/campaign FKs; timestamps and delivery/conversion consistency. No internal partition gaps; starts 2023-07-01, 14 days after global start."
    },
    "digital_events": {
      "documented_relationships": [
        "digital_events.customer_id -> customers.customer_id",
        "digital_events.product_id -> products.product_id"
      ],
      "purpose": "Historical app/web interaction events, not financial ledger records.",
      "banking_frontend_need": "Not needed for dated transaction facts. event_value and event_type do not establish an authorized transaction or its status.",
      "next_contracts": "Unique event_id; optional customer/product FKs; same-owner validation when both are present; timestamps; remove IP/session/URLs from consumer outputs. Largest family (3.757 GB), no row profile yet."
    },
    "satisfaction_surveys": {
      "documented_relationships": [
        "satisfaction_surveys.interaction_id -> call_center_interactions.interaction_id",
        "satisfaction_surveys.customer_id -> customers.customer_id",
        "satisfaction_surveys.agent_id -> service_agents.agent_id"
      ],
      "purpose": "Historical CSAT/NPS/CES evidence linked to historical interactions.",
      "banking_frontend_need": "Optional future service analytics; not an outcome measurement for the new assistant demo.",
      "next_contracts": "Unique survey_id; interaction/customer/agent FKs; same customer as interaction; type-dependent score ranges. Free text stays private/counts-only."
    },
    "daily_exchange_rates": {
      "documented_relationships": [
        "Composite PK: date + source_currency + target_currency; no documented FK"
      ],
      "purpose": "Historical currency conversion reference.",
      "banking_frontend_need": "Not needed while frontend shows original amount/currency. Required if future UI performs cross-currency totals/conversion; no assumption about missing amount_usd.",

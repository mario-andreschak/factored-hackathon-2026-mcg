        {
          "from": "merge_parallel",
          "condition_function": "route_after_merge",
          "description": "Barrera de las tres ramas. Sesión inválida, ataque o referencia ajena del preprocesador => policy_engine; pending vigente => resolve_clarification; resto => detect_intent.",
          "mapping": {
            "policy_engine": "policy_engine",
            "resolve_clarification": "resolve_clarification",
            "detect_intent": "detect_intent"
          }
        },
        {
          "from": "resolve_clarification",
          "condition_function": "route_after_clarification",
          "description": "NEW_REQUEST limpia pending => detect_intent; SELECTED/CONFIRMED válidos => run_tools para releer target y política; DENIED/UNCLEAR => policy_engine.",
          "mapping": {
            "detect_intent": "detect_intent",
            "run_tools": "run_tools",
            "policy_engine": "policy_engine"
          }
        },
        {
          "from": "detect_intent",
          "condition_function": "route_after_intent",
          "description": "DISPUTE/INQUIRY/STATUS => load_customer_context; resto => policy_engine. Consultas independientes se procesan serialmente.",
          "mapping": {
            "load_customer_context": "load_customer_context",
            "policy_engine": "policy_engine"
          }
        },
        {
          "from": "extract_slots",
          "condition_function": "route_after_slots",
          "description": "Referencia ajena, fallo de perfil o criterios insuficientes => policy_engine; resto => run_tools. Guardas repetidos en herramientas.",
          "mapping": {
            "policy_engine": "policy_engine",
            "run_tools": "run_tools"
          }
        },
        {
          "from": "policy_engine",
          "condition_function": "route_after_policy",
          "description": "Autorización fresca y action_attempted=false => execute_action; handoff.required y no intentado => generate_handoff_summary (incluye ACTION_UNVERIFIED); resto => generate.",
          "mapping": {
            "execute_action": "execute_action",
            "generate_handoff_summary": "generate_handoff_summary",
            "generate": "generate"
          }
        },
        {
          "from": "generate",
          "condition_function": "route_after_generate",
          "description": "Error de LLM o grounding_violation → safe_fallback; si no → validate_response",
          "mapping": {
            "validate_response": "validate_response",
            "safe_fallback": "safe_fallback"
          }
        },
        {
          "from": "validate_response",
          "condition_function": "route_after_validation",
          "description": "OK → persist; falla con reintento disponible → generate; falla sin reintentos → safe_fallback",
          "mapping": {
            "persist": "persist",
            "generate": "generate",
            "safe_fallback": "safe_fallback"
          }
        }
